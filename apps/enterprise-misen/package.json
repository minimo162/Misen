{
  "name": "@misen/enterprise-runtime-poc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "acceptance": "npm run build && node dist/acceptance/run.js",
    "live": "npm run build && node dist/acceptance/live.js",
    "demo": "npm run build && node dist/web/server.js",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.17",
    "@assistant-ui/react-markdown": "0.14.13",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@office-kit/xlsx": "0.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "esbuild": "0.25.11",
    "typescript": "6.0.3"
  }
}
