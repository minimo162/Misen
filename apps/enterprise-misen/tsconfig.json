{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "noImplicitAny": false, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": ".", "declaration": false
