{
  "name": "coding-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/gate.mjs --tier unit",
    "test:unit": "node test/gate.mjs --tier unit",
    "test:integration": "node test/gate.mjs --tier integration",
    "test:live": "node test/gate.mjs --tier live",
    "test:all": "node test/gate.mjs --tier all",
    "gate": "node test/gate.mjs --tier all",
    "start": "node dist/index.js",
    "serve": "node dist/server.js",
    "bridge": "node dist/openai-bridge.js",
    "benchmark": "node esbuild.config.mjs && node dist/benchmark.js",
    "benchmark:mock": "node esbuild.config.mjs && node dist/benchmark.js --mock --provider openai --model benchmark-loopback",
    "smoke": "node esbuild.config.mjs && node dist/smoke.js",
    "flex:validate": "node esbuild.config.mjs && node dist/flex-harness.js",
    "flex:validate:live": "node esbuild.config.mjs && node dist/flex-harness.js --live",
    "flex:measure:copilot": "node test/measure-flex-copilot.mjs",
    "flex:measure:ollama": "node test/measure-flex-ollama.mjs",
    "computer-use:measure:ollama": "node esbuild.config.mjs && node dist/measure-computer-use-ollama.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.72",
    "@assistant-ui/react": "0.15.16",
    "ai": "^6.0.268",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shell-quote": "1.10.0"
  }
}
