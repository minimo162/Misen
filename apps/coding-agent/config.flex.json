{
  "agentLoop": "v1",
  "provider": "copilot-edge",
  "restrictToWorkspace": true,
  "allowArbitraryCommands": true,
  "safeCommandOnly": true,
  "permissions": [
    { "permission": "list_files", "pattern": "*", "action": "allow" },
    { "permission": "read_file", "pattern": "*", "action": "allow" },
    { "permission": "read_files", "pattern": "*", "action": "allow" },
    { "permission": "read_xlsx", "pattern": "*", "action": "allow" },
    { "permission": "search_files", "pattern": "*", "action": "allow" },
    { "permission": "write_file", "pattern": "*", "action": "allow" },
    { "permission": "write_file.overwrite", "pattern": "*", "action": "ask" },
    { "permission": "start_process", "pattern": "*", "action": "allow" },
    { "permission": "run_command", "pattern": "*", "action": "ask" }
  ],
  "_comment_permissions": "この最小確認プロファイルは将来 agentLoop=v2 を選択したときだけ有効です。既定の v1 では従来の承認経路を使います。",
  "_comment_destructive_operations": "削除・破壊的操作は既存ハードガードが拒否し、permissions では承認できないため規則不要です。",
  "autoApprove": { "write": false, "command": false },
  "maxToolIterations": 8,
  "maxToolExecutions": 6,
  "maxWriteExecutions": 2,
  "maxCommandExecutions": 2,
  "maxNoProgress": 2,
  "systemPrompt": "あなたはワークスペース境界を守る支援エージェントです。hostツールだけを使い、必要最小限の一手を選びます。ファイル変更とアプリ起動は利用者の承認を待ちます。「直下」「そのフォルダだけ」の一覧はhost.list_filesのrecursive=falseを使い、第0ターンの再帰一覧を流用しません。「開く」「表示」は内容の読取りではなく、host.start_processまたはhost.run_commandで対象を既定アプリへ実際に開きます。起動ツールの成功結果がない限り、開いたと報告しません。ワークスペース外、削除、ネットワーク、レジストリ、エンコード済みコマンド、複合シェル入力は要求しません。結果を確認できないときは推測せず、その理由を日本語で簡潔に答えます。",
  "copilot": {
    "url": "https://m365.cloud.microsoft/chat/",
    "cdpPort": 0,
    "reuseExistingEdge": false,
    "displayMode": "foreground",
    "agentMode": true,
    "modelPriority": []
  },
  "localResponseConverter": {
    "enabled": false,
    "baseURL": "http://127.0.0.1:8080/v1",
    "model": "Qwen3.5-4B-Q4_K_M.gguf",
    "timeoutMs": 30000,
    "apiKey": "company-apps-flex-local"
  }
}
