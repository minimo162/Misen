{
  "agentLoop": "v2",
  "provider": "ollama",
  "baseURL": "http://127.0.0.1:11434/v1",
  "model": "ornith-1.5:9b",
  "agentOptimization": "on",
  "generationLimits": {
    "readToolRequestMaxOutputTokens": 256,
    "actionToolRequestMaxOutputTokens": 1024,
    "finalResponseMaxOutputTokens": 192
  },
  "temperature": 0.2,
  "maxToolIterations": 10,
  "maxToolExecutions": 8,
  "maxWriteExecutions": 3,
  "maxCommandExecutions": 2,
  "maxNoProgress": 2,
  "allowArbitraryCommands": false,
  "safeCommandOnly": true,
  "restrictToWorkspace": true,
  "autoApprove": { "write": false, "command": false },
  "permissions": [
    { "permission": "list_files", "pattern": "*", "action": "allow" },
    { "permission": "read_file", "pattern": "*", "action": "allow" },
    { "permission": "read_files", "pattern": "*", "action": "allow" },
    { "permission": "read_xlsx", "pattern": "*", "action": "allow" },
    { "permission": "search_files", "pattern": "*", "action": "allow" },
    { "permission": "write_file", "pattern": "*", "action": "ask" },
    { "permission": "write_file.overwrite", "pattern": "*", "action": "ask" },
    { "permission": "start_process", "pattern": "*", "action": "ask" },
    { "permission": "run_command", "pattern": "*", "action": "ask" }
  ],
  "_comment_baseURL": "OllamaのOpenAI互換APIはloopbackのhttp://127.0.0.1:11434/v1を指定します。",
  "_comment_model": "モデル名はOLLAMA_MODEL環境変数またはollama listに合わせて変更します。既定はornith-1.5:9bです。",
  "_comment_reasoningEffort": "reasoningEffortは省略時unsetです。指定する場合だけhigh / medium / low / noneを設定し、Ollamaへreasoning_effortとして送信します。",
  "_comment_num_ctx": "Ollama OpenAI互換エンドポイントではnum_ctxはモデル側の設定です。この設定でnum_ctxを送ることはできません。",
  "_comment_utf8": "Ollama経路はJSON要求にcharset=utf-8を付け、JSON応答をfatal UTF-8で検証します。npm run smokeで回帰確認できます。"
}
